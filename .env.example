# Local profile runs on an embedded H2 database. Choose "mysql" for MySQL.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Required in the mysql profile. Create the database before starting the app.
DB_URL=jdbc:mysql://localhost:3306/estatepro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=estatepro
DB_PASSWORD=change-me

# Replace with a random value of at least 32 characters outside local development.
JWT_SECRET=local-only-change-this-secret-before-deployment-32-characters
JWT_EXPIRATION_MS=86400000
